<hibernate-configuration>

    <session-factory>
    <property name="hibernate.connection.driver_class">org. com.mysql.cj.jdbc.Driver</property>
    <property name="hibernate.connection.url">  jdbc:mysql://localhost:3306/hibernatedb</property>
    <property name="hibernate.connection.username">root</property>
    <property name="hibernate.connection.password">root</property>
    <property name="hibernate.dialect"> org.hibernate.dialect. org.hibernate.dialect.MySQLDialect </property>
    <property name="cache.provider_class"> org.hibernate.cache.NoCacheProvider </property>
    <property name="show-sql">true</property>
    <mapping class="org.olive.UserDetails"/>
    </session-factory>
</hibernate-configuration>
